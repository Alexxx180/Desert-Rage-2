[node name="title" parent="stack" instance=ExtResource("6_2xh6b")]
layout_mode = 2
theme_override_font_sizes/normal_font_size = 24
theme_override_font_sizes/italics_font_size = 32
text = "[table=2]
[cell][left][i][color=b5b5b5]Инвентарь[/color][/i]
[b][i]✋[/i][/b] Выберите предмет и ячейку для перемещения. Кликните дважды на предмете для использования.[/left][/cell]
[cell][left][i][color=b5b5b5]Бестиарий[/color][/i]
· В бестиарии находятся сведения о противниках, людях и исследованиях. Наведите курсор на существо чтобы получить сводку о нём.[/left][/cell]
[cell][left][i][color=b5b5b5]Статусы[/color][/i]
· Вы можете получить вредный статус \"Симптом\" наткнувшись на особые ловушки или от противников. Также некоторые водные растворы могут дать полезный побочный эфффект - \"Лакмус\". Используйте предметы чтобы снимать симптомы и получать лакмусы.[/left][/cell]
[cell][left][i][color=b5b5b5]Сортировка[/color][/i]
· При нажатии на колбы [color=91fe90FF][b][i]🫙[/i][/b]А[/color] [color=7aa1ffFF][b][i]🫙[/i][/b]Р[/color] лежащие слева-направо предметов восполняющих АР восстановливает героев согласно сортировке. [b][i]🔼[/i][/b] По возрастанию - с экономией предметов. [b][i]🔽[/i][/b] По убыванию - без экономии. [b][i]🔀[/i][/b] В случайном порядке - первым же предметом[/left][/cell]

[/table]"

