bbcode_enabled = true
text = "[ul]Здесь описаны умения и способности - приёмы ваших героев. Описание способности включает в себя комбо, стоимость, площадь и эффект
Слоты - умения, входящие в комбо
Эффект - полезное действие способности
Комбо или комбинация - набор слотов, используемых для получения эффекта
Стоимость - общее количество необходимого ресурса для действия способности
Площадь - сколько противников может быть затронуто способностью
I - одна сущность или колонна сущностей стоящих друг за другом
.I. - малая группы сущностей, импульс по небольшой площади
..I.. - большая группа сущностей, импульс по большой площади
III - малая группы сущностей, эффект по небольшой площади
IIIII - большая группа сущностей, эффект по большой площади или по всем сущностям на местности
[p]В режиме наведения вы можете выбрать один из предоставленных приемов. Затем, вы можете выбрать противников
ЛКМ по способности - ЛКМ по противнику - выполнение всей комбинации
ПКМ по способности - Наведение на противника - любое из умений %s / %s / %s / %s - выполнение слота комбинации. Вам необходимо выбрать столько целей, сколько указано слотов в способности[/p]"
fit_content = true
autowrap_mode = 2
