size_flags_stretch_ratio = 0.25
theme = ExtResource("1_vvrgj")
bbcode_enabled = true
text = " Здесь находятся приоритеты героев. В ходе сражений с противниками вы получаете Очки Пытливости - опыт."
fit_content = true
autowrap_mode = 2

[node name="priority" type="HBoxContainer" parent="details"]
layout_mode = 2

[node name="one" type="RichTextLabel" parent="details/priority"]
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.25
theme = ExtResource("1_vvrgj")
bbcode_enabled = true
text = "[b][i]👉[/i][/b] Достаточное количество, увеличивает выбранный приоритет на 1. Вы можете выбрать любой из трёх для каждого героя в любой момент времени."
fit_content = true
autowrap_mode = 2

[node name="maxed" type="RichTextLabel" parent="details/priority"]
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.25
theme = ExtResource("1_vvrgj")
bbcode_enabled = true
text = "[b][i]⭐️[/i][/b] Приоритеты не могут быть выше определённого уровня. Как только вы достигаете максимума, ваш герой меняет приоритет."
fit_content = true
autowrap_mode = 2

[node name="effect" type="RichTextLabel" parent="details"]
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.25
theme = ExtResource("1_vvrgj")
bbcode_enabled = true
text = "· При повышении вы получаете прирост к определённым показателям, облегчающим ваше положение в следующих битвах.

· Вместе с этим согласно вашим приоритетам вы можете получить уникальный эффект. Уникальные эффекты героев делятся на возможности и способности."
fit_content = true
autowrap_mode = 2

[node name="skills" type="HBoxContainer" parent="details"]
layout_mode = 2

[node name="possibility" type="RichTextLabel" parent="details/skills"]
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.25
theme = ExtResource("1_vvrgj")
bbcode_enabled = true
text = "[b][i]🎖[/i][/b] Возможность - приводится в действие по событию или закреплена за персонажем насовсем. Например, дополнительный опыт при допытывании."
fit_content = true
autowrap_mode = 2

[node name="ability2" type="RichTextLabel" parent="details/skills"]
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.25
theme = ExtResource("1_vvrgj")
bbcode_enabled = true
text = "[b][i]⚔️[/i][/b] Способность - приводится в действие во время выполнения комбо - нажатия кнопок, отвечающих за действие, движение героев и их умений."
fit_content = true
autowrap_mode = 2

[node name="value" type="RichTextLabel" parent="details"]
custom_minimum_size = Vector2(50, 0)
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 0.25
theme = ExtResource("1_vvrgj")
bbcode_enabled = true
text = "· Подбирайте их с умом. Наличие определённых возможностей и способностей помогают в конкретных ситуациях, а также облегчают ваше прохождение.

· Некоторые способности могут быть приобретены только после чтения книг нужного типа. Ищите книги, чтобы раздвинуть свои возможности."
fit_content = true
autowrap_mode = 2
