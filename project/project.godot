}
config/description="Puzzle Action RPG with command battle system."
config/version="1.0.3"
run/main_scene="res://asset/system/scene/level/cave/sparkling/0/2/level.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
boot_splash/image="uid://c2vl4d5jdnfon"
